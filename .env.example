# Banco de dados PostgreSQL (obrigatório)
# Local (docker compose up -d): postgresql://divida:divida@localhost:5432/controle_divida
# Produção: string de conexão do provedor (Neon, Supabase, Railway, RDS…)
DATABASE_URL="postgresql://divida:divida@localhost:5432/controle_divida"

# URL pública do site — usada nos links dos e-mails de recuperação de senha.
# Na Vercel pode ficar em branco: o domínio do deploy é detectado sozinho.
APP_URL="http://localhost:3000"

# E-mail transacional (Resend). Sem RESEND_API_KEY nada é enviado: em
# desenvolvimento o link de redefinição aparece na própria tela.
RESEND_API_KEY=""
MAIL_FROM="Controle de dívida <nao-responda@seu-dominio.com>"

# Configuração inicial — usados só pelo `npm run db:seed`.
# Sem as senhas, o script gera senhas fortes e as imprime uma única vez.
DEBT_DEBTOR_EMAIL="jp@exemplo.com"
DEBT_CREDITOR_EMAIL="bruno@exemplo.com"
DEBT_DEBTOR_PASSWORD=""
DEBT_CREDITOR_PASSWORD=""
